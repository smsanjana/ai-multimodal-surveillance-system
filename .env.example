# Environment Configuration Example
# Copy to .env for local overrides

LOG_LEVEL=INFO
LOG_FILE=logs/surveillance.log
DATABASE_PATH=data/surveillance.db

# AI Model Configuration
YOLO_MODEL_PATH=data/models/yolov8n_kiit_mita.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# Video Processing Configuration
MAX_VIDEO_DURATION_SECONDS=120
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_MISSED_FRAMES=5
MOVEMENT_PIXEL_THRESHOLD=15.0

# Analyst Configuration
DEFAULT_ANALYST_ID=ANALYST_DEFAULT
